generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
}

enum OccupancyProfile {
  mostly_day
  mostly_evening
  mixed
}

// -------------------------------------------------------------
// 1. Unified User (Auth + Domain)
// -------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   // Secure bcrypt hash
  fullName     String
  role         Role     @default(owner)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  sites        Site[]
}

// -------------------------------------------------------------
// 2. Core Domain: Sites & Topologies
// -------------------------------------------------------------
model Site {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteName  String
  address   String
  latitude  Float
  longitude Float
  timezone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solarSystems  SolarSystem[]
  deviceProfile SiteDeviceProfile?
  tariffs       Tariff[]
  currentSnapshot    SiteCurrentSnapshot?
  dailySummaries     SiteDailySummary[]
  monthlySummaries   SiteMonthlySummary[]
  inverterConnection InverterConnection?
  telemetryReadings  TelemetryReading[]

  @@index([userId])
}

// -------------------------------------------------------------
// 3. Hardware Modules (1:N capability)
// -------------------------------------------------------------
model SolarSystem {
  id               String    @id @default(uuid())
  siteId           String
  site             Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  systemSizeKw     Float
  tilt             Float
  azimuth          Float
  panelWattage     Float
  panelEfficiency  Float     // Canonical unit: percentage (0–100), e.g. 21.5 means 21.5%
  // panelCount + panelType are user-supplied catalog metadata; nullable so
  // existing rows (created before this column existed) keep working.
  panelCount       Int?
  panelType        String?
  inverterType     String?
  // Date the system was physically installed. Optional because legacy rows
  // pre-date this column and not every onboarding flow collects it.
  installationDate DateTime?
  lastCleaningDate DateTime
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([siteId])
}

// -------------------------------------------------------------
// 4. Device Profiling (V3 AI Alignment)
// -------------------------------------------------------------
model SiteDeviceProfile {
  id                           String           @id @default(uuid())
  siteId                       String           @unique
  site                         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  hasBoiler                    Boolean          @default(false)
  hasEv                        Boolean          @default(false)
  hasBattery                   Boolean          @default(false)
  hasDishwasher                Boolean          @default(false)
  hasWashingMachine            Boolean          @default(false)
  hasAc                        Boolean          @default(false)
  usageFlexibilityLevel        Int              @default(3)
  flexibleLoadShiftingPossible Boolean          @default(false)
  openToUpgrades               Boolean          @default(true)
  homeOccupancyProfile         OccupancyProfile // Strict enum for LLM context constraint

  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  @@index([siteId])
}

// -------------------------------------------------------------
// 5. Financial Configuration (Temporal)
// -------------------------------------------------------------
model Tariff {
  id                  String    @id @default(uuid())
  siteId              String
  site                Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  selfConsumptionRate Float
  exportRate          Float
  currency            String
  isActive            Boolean   @default(true)
  effectiveFrom       DateTime
  effectiveUntil      DateTime? // Null means currently active
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([siteId])
}

// -------------------------------------------------------------
// 6. Marketplace Foundation: Revenue & Leads
// -------------------------------------------------------------

model Provider {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  category     ProviderCategory
  description  String?
  serviceAreas String[]
  phone        String?
  whatsappUrl  String?
  websiteUrl   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recommendationLinks RecommendationLink[]
}

model Product {
  id                String          @id @default(uuid())
  name              String
  slug              String          @unique
  category          ProductCategory
  description       String?
  brand             String?
  estimatedPriceMin Float?
  estimatedPriceMax Float?
  affiliateUrl      String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  recommendationLinks RecommendationLink[]
}

model LeadIntent {
  id              String       @id @default(uuid())
  siteId          String
  userId          String
  sourceType      LeadSourceType
  sourceReference String?
  title           String
  message         String?
  status          LeadStatus   @default(new_lead)
  estimatedValue  Float?
  metadataJson    Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([siteId])
  @@index([userId])
  @@index([status])
}

model RecommendationLink {
  id          String    @id @default(uuid())
  triggerType String
  providerId  String?
  provider    Provider? @relation(fields: [providerId], references: [id])
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  priority    Int       @default(0)
  countryCode String?
  isActive    Boolean   @default(true)

  @@index([triggerType])
}

enum ProviderCategory {
  cleaning
  maintenance
  installation
  battery
  ev_charging
  automation
}

enum ProductCategory {
  battery
  ev_charger
  switcher
  cooling
  automatic_cleaning
}

enum LeadSourceType {
  cleaning_recommendation
  battery_recommendation
  ev_recommendation
  automation_recommendation
}

enum LeadStatus {
  new_lead
  submitted
  contacted
  closed
  cancelled
}

// -------------------------------------------------------------
// 7. Data Orchestration & Snapshot Engine
// -------------------------------------------------------------

model SiteCurrentSnapshot {
  id              String   @id @default(uuid())
  siteId          String   @unique
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fetchedAt       DateTime
  weatherJson     Json?
  solarJson       Json?
  aggregateJson   Json?
  aiContextJson   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([siteId])
}

model SiteDailySummary {
  id               String   @id @default(uuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  expectedKwh      Float
  actualKwh        Float
  deviationPercent Float
  soilingScore     Float?
  heatScore        Float?
  dailySavings     Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([siteId, date])
  @@index([siteId])
}

// -------------------------------------------------------------
// 8. Telemetry Ingestion (Phase 9): real inverter data
// -------------------------------------------------------------

enum InverterVendor {
  solaredge
  enphase
  fronius
  sma
  mock
}

enum InverterConnectionStatus {
  pending
  active
  error
  disconnected
}

model InverterConnection {
  id               String                   @id @default(uuid())
  siteId           String                   @unique
  site             Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  vendor           InverterVendor
  // Vendor-side identifier for the plant/site (e.g. SolarEdge site id).
  externalSystemId String?
  // AES-256-GCM encrypted vendor API key. Never returned by the API.
  apiKeyEncrypted  String
  status           InverterConnectionStatus @default(pending)
  lastSyncAt       DateTime?
  lastError        String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([status])
}

model TelemetryReading {
  id              String         @id @default(uuid())
  siteId          String
  site            Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  // Interval start, UTC.
  timestamp       DateTime
  // Energy produced during the interval, watt-hours.
  productionWh    Float
  intervalMinutes Int            @default(15)
  source          InverterVendor

  createdAt       DateTime       @default(now())

  @@unique([siteId, timestamp])
  @@index([siteId, timestamp(sort: Desc)])
}

model SiteMonthlySummary {
  id               String   @id @default(uuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  month            DateTime @db.Date // Store the first day of the month
  totalExpected    Float
  totalActual      Float
  totalSavings     Float?
  avgDeviation     Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([siteId, month])
  @@index([siteId])
}
