# App
NODE_ENV=development
WEB_PORT=3001

# API
API_PORT=3000
JWT_SECRET=replace_me
OPENAI_API_KEY=

# Engine
ENGINE_PORT=8000
ENGINE_BASE_URL=http://localhost:8000

# Database
POSTGRES_DB=solar_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Optional cache
REDIS_PORT=6379

# External APIs (Provider config)
PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_3
PVGIS_FALLBACK_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_2
PVGIS_OUTPUT_FORMAT=json
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_FORECAST_DAYS=7
OPEN_METEO_TIMEZONE=auto
OPENCAGE_BASE_URL=https://api.opencagedata.com
OPENCAGE_API_KEY=
OPENCAGE_GEOCODE_PATH=/geocode/v1/json
OPENCAGE_DEFAULT_LANGUAGE=native
OPENCAGE_DEFAULT_LIMIT=5
OPENCAGE_NO_ANNOTATIONS=1
OPENCAGE_NO_RECORD=1
OPENWEATHER_BASE_URL=https://api.openweathermap.org
OPENWEATHER_API_KEY=
OPENWEATHER_UNITS=metric
OPENWEATHER_LANG=en
OPENWEATHER_EXCLUDE=minutely
OPENWEATHER_ALERTS_ONLY_EXCLUDE=current,minutely,hourly,daily
OPENWEATHER_ONECALL_PATH=/data/3.0/onecall
OPENWEATHER_TIMEMACHINE_PATH=/data/3.0/onecall/timemachine
OPENWEATHER_DAY_SUMMARY_PATH=/data/3.0/onecall/day_summary
OPENWEATHER_OVERVIEW_PATH=/data/3.0/onecall/overview
OPENWEATHER_ASSISTANT_SESSION_PATH=/assistant/session
OPENWEATHER_ASSISTANT_SESSION_RESUME_PATH=/assistant/session/{session_id}
OPENWEATHER_DAY_SUMMARY_TZ=
OPENWEATHER_OVERVIEW_DATE=
OPENWEATHER_REFRESH_SECONDS=600
